<UserControl x:Class="PlansyncRevitPlugin.UI.ClashesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:conv="clr-namespace:PlansyncRevitPlugin.UI.Converters"
             xmlns:vm="clr-namespace:PlansyncRevitPlugin.UI.ViewModels"
             Background="{DynamicResource PlansyncSurfaceAltBrush}"
             Foreground="{DynamicResource PlansyncTextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
             FontSize="12.5"
             PreviewKeyDown="Panel_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PlansyncRevitPlugin;component/UI/Themes/PlansyncTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

            <DataTemplate DataType="{x:Type vm:ClashRowViewModel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <DockPanel>
                            <Ellipse Width="8" Height="8"
                                     Fill="{DynamicResource PlansyncClashItem1Brush}"
                                     Margin="0,3,6,0"
                                     VerticalAlignment="Top" />
                            <TextBlock Text="{Binding Item1Name}"
                                       Style="{StaticResource PlansyncRowTitle}" />
                        </DockPanel>
                        <DockPanel Margin="0,3,0,0">
                            <Ellipse Width="8" Height="8"
                                     Fill="{DynamicResource PlansyncClashItem2Brush}"
                                     Margin="0,3,6,0"
                                     VerticalAlignment="Top" />
                            <TextBlock Text="{Binding Item2Name}"
                                       Style="{StaticResource PlansyncRowTitle}" />
                        </DockPanel>
                        <TextBlock Text="{Binding ListMetaLine}"
                                   Style="{StaticResource PlansyncMetaText}"
                                   Margin="14,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <TextBlock Text="{Binding StatusLabel}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Margin="8,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource PlansyncErrorAccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="ACTIVE">
                                            <Setter Property="Foreground" Value="{DynamicResource PlansyncWarnTextBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="RESOLVED">
                                            <Setter Property="Foreground" Value="{DynamicResource PlansyncSuccessTextBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="IGNORED">
                                            <Setter Property="Foreground" Value="{DynamicResource PlansyncFaintTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border HorizontalAlignment="Right"
                                CornerRadius="4"
                                Padding="6,1"
                                Margin="8,0,0,0"
                                BorderThickness="1"
                                Background="{DynamicResource PlansyncHoverBgBrush}"
                                BorderBrush="{DynamicResource PlansyncBorderBrush}">
                            <TextBlock Text="{Binding TypeLabel}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PlansyncSecondaryTextBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource PlansyncSurfaceBrush}"
                BorderBrush="{DynamicResource PlansyncBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,8"
                Visibility="{Binding IsListOpen, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PlansyncIconButton}"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Refresh from Plansync">
                        <iconPacks:PackIconLucide Kind="RefreshCw" Width="14" Height="14"
                                                  Foreground="{DynamicResource PlansyncTextBrush}" />
                    </Button>
                    <Grid>
                        <iconPacks:PackIconLucide Kind="Search"
                                                  Width="13" Height="13"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Panel.ZIndex="1"
                                                  Foreground="{DynamicResource PlansyncFaintTextBrush}" />
                        <TextBox Style="{StaticResource PlansyncSearchBox}"
                                 Padding="28,5,8,5"
                                 FontSize="12.5"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search element or model name" />
                    </Grid>
                </DockPanel>

                <TextBlock Text="Test" Style="{StaticResource PlansyncFieldLabel}" />
                <ComboBox ItemsSource="{Binding Tests}"
                          SelectedItem="{Binding SelectedTest}"
                          DisplayMemberPath="Name"
                          Style="{StaticResource PlansyncComboBox}"
                          Margin="0,0,0,8"
                          ToolTip="Clash test" />

                <WrapPanel>
                    <ToggleButton Content="Open"
                                  Style="{StaticResource PlansyncChipToggle}"
                                  IsChecked="{Binding IsFilterOpen, Mode=OneWay}"
                                  Command="{Binding FilterOpenCommand}" />
                    <ToggleButton Content="Resolved"
                                  Style="{StaticResource PlansyncChipToggle}"
                                  IsChecked="{Binding IsFilterResolved, Mode=OneWay}"
                                  Command="{Binding FilterResolvedCommand}" />
                    <ToggleButton Content="All"
                                  Style="{StaticResource PlansyncChipToggle}"
                                  IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                                  Command="{Binding FilterAllCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="0"
                Background="{DynamicResource PlansyncSurfaceBrush}"
                BorderBrush="{DynamicResource PlansyncBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6"
                Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource PlansyncCompactButton}"
                        Command="{Binding BackToListCommand}"
                        ToolTip="Back to clashes"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="ArrowLeft" Width="13" Height="13"
                                                  Foreground="{DynamicResource PlansyncTextBrush}"
                                                  VerticalAlignment="Center" />
                        <TextBlock Text="Back" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PlansyncIconButton}"
                            Command="{Binding PreviousCommand}"
                            ToolTip="Previous clash"
                            Margin="0,0,2,0">
                        <iconPacks:PackIconLucide Kind="ChevronLeft" Width="14" Height="14"
                                                  Foreground="{DynamicResource PlansyncTextBrush}" />
                    </Button>
                    <Button Style="{StaticResource PlansyncIconButton}"
                            Command="{Binding NextCommand}"
                            ToolTip="Next clash">
                        <iconPacks:PackIconLucide Kind="ChevronRight" Width="14" Height="14"
                                                  Foreground="{DynamicResource PlansyncTextBrush}" />
                    </Button>
                </StackPanel>
                <TextBlock Text="{Binding DetailTitle}"
                           Style="{StaticResource PlansyncRowTitle}"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <ListBox x:Name="ClashesList"
                     Margin="8"
                     ItemsSource="{Binding FilteredClashes}"
                     SelectedItem="{Binding Selected}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="List_PreviewKeyDown"
                     Visibility="{Binding IsListOpen, Converter={StaticResource BoolToVis}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource PlansyncPaneListItem}" />
                </ListBox.ItemContainerStyle>
            </ListBox>

            <StackPanel VerticalAlignment="Center"
                        Margin="24,16"
                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding EmptyTitle}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{DynamicResource PlansyncTextBrush}" />
                <TextBlock Text="{Binding EmptyBody}"
                           Margin="0,6,0,10"
                           FontSize="12"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{DynamicResource PlansyncMutedBrush}" />
                <Button Style="{StaticResource PlansyncCompactButton}"
                        Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Center"
                        Content="Refresh" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="12,8,12,8"
                          Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Model elements" Style="{StaticResource PlansyncFieldLabel}" />
                    <Border Background="{DynamicResource PlansyncClashItem1BgBrush}"
                            BorderBrush="{DynamicResource PlansyncClashItem1BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,6"
                            Margin="0,0,0,6">
                        <StackPanel>
                            <DockPanel>
                                <Ellipse Width="8" Height="8"
                                         Fill="{DynamicResource PlansyncClashItem1Brush}"
                                         Margin="0,3,8,0"
                                         VerticalAlignment="Top" />
                                <TextBlock Text="{Binding Selected.Item1Name}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource PlansyncTextBrush}" />
                            </DockPanel>
                            <TextBlock Text="{Binding Selected.Item1Meta}"
                                       Style="{StaticResource PlansyncMetaText}"
                                       TextWrapping="Wrap"
                                       Margin="16,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource PlansyncClashItem2BgBrush}"
                            BorderBrush="{DynamicResource PlansyncClashItem2BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,6"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel>
                                <Ellipse Width="8" Height="8"
                                         Fill="{DynamicResource PlansyncClashItem2Brush}"
                                         Margin="0,3,8,0"
                                         VerticalAlignment="Top" />
                                <TextBlock Text="{Binding Selected.Item2Name}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource PlansyncTextBrush}" />
                            </DockPanel>
                            <TextBlock Text="{Binding Selected.Item2Meta}"
                                       Style="{StaticResource PlansyncMetaText}"
                                       TextWrapping="Wrap"
                                       Margin="16,4,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding Selected.DistanceLabel}"
                               FontSize="12.5"
                               Margin="0,0,0,10"
                               Foreground="{DynamicResource PlansyncTextBrush}" />

                    <TextBlock Text="Status" Style="{StaticResource PlansyncFieldLabel}" />
                    <WrapPanel Margin="0,0,0,10">
                        <ToggleButton Content="New"
                                      Style="{StaticResource PlansyncChipToggle}"
                                      IsChecked="{Binding IsStatusNew, Mode=OneWay}"
                                      Command="{Binding SetStatusCommand}"
                                      CommandParameter="NEW" />
                        <ToggleButton Content="Active"
                                      Style="{StaticResource PlansyncChipToggle}"
                                      IsChecked="{Binding IsStatusActive, Mode=OneWay}"
                                      Command="{Binding SetStatusCommand}"
                                      CommandParameter="ACTIVE" />
                        <ToggleButton Content="Resolved"
                                      Style="{StaticResource PlansyncChipToggle}"
                                      IsChecked="{Binding IsStatusResolved, Mode=OneWay}"
                                      Command="{Binding SetStatusCommand}"
                                      CommandParameter="RESOLVED" />
                        <ToggleButton Content="Ignored"
                                      Style="{StaticResource PlansyncChipToggle}"
                                      IsChecked="{Binding IsStatusIgnored, Mode=OneWay}"
                                      Command="{Binding SetStatusCommand}"
                                      CommandParameter="IGNORED" />
                    </WrapPanel>

                    <TextBlock Text="{Binding CommentsHeader}" Style="{StaticResource PlansyncFieldLabel}" />
                    <Border Background="{DynamicResource PlansyncSurfaceBrush}"
                            BorderBrush="{DynamicResource PlansyncBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,0,0,8">
                        <Grid MinHeight="48" MaxHeight="160">
                            <TextBlock Text="Loading…"
                                       Margin="10,8"
                                       Style="{StaticResource PlansyncMetaText}"
                                       Visibility="{Binding IsCommentsLoading, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="No comments yet."
                                       Margin="10,8"
                                       Style="{StaticResource PlansyncMetaText}"
                                       Visibility="{Binding CommentsEmptyVisible, Converter={StaticResource BoolToVis}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Padding="8"
                                          Visibility="{Binding HasComments, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Comments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:IssueCommentRowViewModel}">
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding CreatedAtLabel}"
                                                           DockPanel.Dock="Right"
                                                           Style="{StaticResource PlansyncMetaText}"
                                                           Margin="8,0,0,0" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding AuthorName}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Body}"
                                                               Margin="0,2,0,0"
                                                               FontSize="12.5"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource PlansyncSecondaryTextBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource PlansyncIconButton}"
                                Command="{Binding PostCommentCommand}"
                                ToolTip="Add comment"
                                Margin="6,0,0,0">
                            <iconPacks:PackIconLucide Kind="Send" Width="13" Height="13"
                                                      Foreground="{DynamicResource PlansyncAccentBrush}" />
                        </Button>
                        <TextBox Text="{Binding NewComment, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PlansyncSearchBox}"
                                 ToolTip="Write a comment" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource PlansyncSurfaceBrush}"
                BorderBrush="{DynamicResource PlansyncBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,8">
            <StackPanel>
                <WrapPanel Margin="0,0,0,6" Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource PlansyncCompactPrimaryButton}"
                            Command="{Binding OpenIn3dCommand}"
                            Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Box" Width="13" Height="13" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Open 3D" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PlansyncCompactButton}"
                            Command="{Binding OpenSectionBoxCommand}"
                            Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Scan" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Section" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PlansyncCompactButton}"
                            Command="{Binding ResetViewCommand}"
                            Margin="0,0,6,6"
                            Content="Reset" />
                </WrapPanel>
                <TextBlock Text="{Binding FooterText}"
                           TextWrapping="NoWrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlansyncMetaText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource PlansyncErrorTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource PlansyncAccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
