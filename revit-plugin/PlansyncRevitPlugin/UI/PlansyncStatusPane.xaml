<UserControl x:Class="PlansyncRevitPlugin.UI.PlansyncStatusPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PlansyncRevitPlugin.UI"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{DynamicResource PlansyncSurfaceAltBrush}"
             Foreground="{DynamicResource PlansyncTextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
             FontSize="13"
             MinWidth="380">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PlansyncRevitPlugin;component/UI/Themes/PlansyncTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource PlansyncSurfaceBrush}"
                BorderBrush="{DynamicResource PlansyncBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Margin="-14,-12,-14,10" Height="3">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource PlansyncHeaderBarStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource PlansyncHeaderBarEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <DockPanel Grid.Row="1" LastChildFill="False">
                    <Image x:Name="LogoImage"
                           DockPanel.Dock="Left"
                           Width="22"
                           Height="22"
                           Stretch="Uniform"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Border x:Name="AuthBadge"
                            DockPanel.Dock="Right"
                            Background="{DynamicResource PlansyncSurfaceAltBrush}"
                            BorderBrush="{DynamicResource PlansyncBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="7,3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource PlansyncFaintTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="AccountStateText"
                                       Text="Checking…"
                                       Foreground="{DynamicResource PlansyncPlaceholderTextBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Premium segmented Status / Issues -->
        <Border Grid.Row="1"
                Background="{DynamicResource PlansyncSurfaceBrush}"
                BorderBrush="{DynamicResource PlansyncBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Border Background="{DynamicResource PlansyncHoverBgBrush}"
                    BorderBrush="{DynamicResource PlansyncBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="3">
                <UniformGrid Columns="2">
                    <ToggleButton x:Name="StatusTabButton"
                                  Style="{StaticResource PlansyncSegmentToggle}"
                                  IsChecked="True"
                                  Click="StatusTab_Click"
                                  Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <iconPacks:PackIconLucide Kind="Activity"
                                                      Width="13" Height="13"
                                                      Margin="0,0,6,0"
                                                      VerticalAlignment="Center" />
                            <TextBlock Text="Status" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="IssuesTabButton"
                                  Style="{StaticResource PlansyncSegmentToggle}"
                                  IsChecked="False"
                                  Click="IssuesTab_Click"
                                  Margin="2,0,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <iconPacks:PackIconLucide Kind="CircleAlert"
                                                      Width="13" Height="13"
                                                      Margin="0,0,6,0"
                                                      VerticalAlignment="Center" />
                            <TextBlock Text="Issues" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                </UniformGrid>
            </Border>
        </Border>

        <!-- Tab bodies (content hosted outside TabItem so Status keeps code-behind names) -->
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="StatusContent"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12">
                    <!-- Account -->
                    <Border Background="{DynamicResource PlansyncSurfaceBrush}"
                            BorderBrush="{DynamicResource PlansyncBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="ACCOUNT"
                                           Foreground="{DynamicResource PlansyncFaintTextBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <iconPacks:PackIconLucide DockPanel.Dock="Right"
                                                          Kind="UserRound"
                                                          Width="14" Height="14"
                                                          Foreground="{DynamicResource PlansyncFaintTextBrush}" />
                            </DockPanel>
                            <TextBlock x:Name="UserText"
                                       Text="Not signed in"
                                       Foreground="{DynamicResource PlansyncTextBrush}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10" />
                            <Button x:Name="AuthActionButton"
                                    Content="Sign in"
                                    Style="{StaticResource PlansyncSecondaryButton}"
                                    HorizontalAlignment="Stretch"
                                    Click="AuthAction_Click"
                                    Padding="12,9" />
                        </StackPanel>
                    </Border>

                    <!-- Destination -->
                    <Border Background="{DynamicResource PlansyncSurfaceBrush}"
                            BorderBrush="{DynamicResource PlansyncBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="DESTINATION"
                                           Foreground="{DynamicResource PlansyncFaintTextBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="DestinationReadyText"
                                           DockPanel.Dock="Right"
                                           HorizontalAlignment="Right"
                                           Text="Not set"
                                           Foreground="{DynamicResource PlansyncErrorAccentBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </DockPanel>

                            <TextBlock Text="Workspace" Foreground="{DynamicResource PlansyncFaintTextBrush}" FontSize="10" />
                            <TextBlock x:Name="WorkspaceText"
                                       Text="—"
                                       Foreground="{DynamicResource PlansyncTextBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,1,0,8"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="Project" Foreground="{DynamicResource PlansyncFaintTextBrush}" FontSize="10" />
                            <TextBlock x:Name="ProjectText"
                                       Text="—"
                                       Foreground="{DynamicResource PlansyncTextBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,1,0,8"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="Folder" Foreground="{DynamicResource PlansyncFaintTextBrush}" FontSize="10" />
                            <Border Background="{DynamicResource PlansyncAccentTintBgBrush}"
                                    BorderBrush="{DynamicResource PlansyncAccentTintBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6"
                                    Margin="0,3,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="Folder"
                                                              Width="15" Height="15"
                                                              Margin="0,0,8,0"
                                                              VerticalAlignment="Center"
                                                              Foreground="{DynamicResource PlansyncAccentBrush}" />
                                    <TextBlock x:Name="FolderText"
                                               Text="—"
                                               Foreground="{DynamicResource PlansyncAccentTintTextBrush}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Last publish -->
                    <Border Background="{DynamicResource PlansyncSurfaceBrush}"
                            BorderBrush="{DynamicResource PlansyncBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="LAST PUBLISH"
                                           Foreground="{DynamicResource PlansyncFaintTextBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <iconPacks:PackIconLucide DockPanel.Dock="Right"
                                                          Kind="Upload"
                                                          Width="14" Height="14"
                                                          Foreground="{DynamicResource PlansyncFaintTextBrush}" />
                            </DockPanel>
                            <TextBlock x:Name="LastPublishSummaryText"
                                       Text="No publish yet this session."
                                       Foreground="{DynamicResource PlansyncTextBrush}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="LastPublishTimeText"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource PlansyncPlaceholderTextBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="LastPublishFilesText"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource PlansyncSecondaryTextBrush}"
                                       FontSize="11.5"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Activity / queue -->
                    <Border Background="{DynamicResource PlansyncSurfaceBrush}"
                            BorderBrush="{DynamicResource PlansyncBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="ACTIVITY"
                                           Foreground="{DynamicResource PlansyncFaintTextBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                                <Border x:Name="QueueBadge"
                                        DockPanel.Dock="Right"
                                        Background="{DynamicResource PlansyncWarnBgBrush}"
                                        BorderBrush="{DynamicResource PlansyncWarnBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="6,2"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="QueueBadgeText"
                                               Text="0 queued"
                                               Foreground="{DynamicResource PlansyncWarnTextBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                </Border>
                            </DockPanel>
                            <TextBlock x:Name="StatusText"
                                       Text="Ready to publish."
                                       Foreground="{DynamicResource PlansyncSecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="QueueFilesText"
                                       Margin="0,8,0,0"
                                       Foreground="{DynamicResource PlansyncPlaceholderTextBrush}"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="OpenDestinationButton"
                            Style="{StaticResource PlansyncPrimaryButton}"
                            HorizontalAlignment="Stretch"
                            Click="OpenDestination_Click"
                            Margin="0,0,0,8"
                            Padding="12,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <iconPacks:PackIconLucide Kind="ExternalLink"
                                                      Width="14" Height="14"
                                                      Foreground="White"
                                                      Margin="0,0,8,0"
                                                      VerticalAlignment="Center" />
                            <TextBlock Text="Open in Plansync" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RetryQueueButton"
                            Content="Retry offline queue"
                            Style="{StaticResource PlansyncSecondaryButton}"
                            HorizontalAlignment="Stretch"
                            Click="RetryQueue_Click"
                            Margin="0,0,0,8"
                            Padding="12,10"
                            Visibility="Collapsed" />
                    <Button Style="{StaticResource PlansyncSecondaryButton}"
                            HorizontalAlignment="Stretch"
                            Click="Refresh_Click"
                            Padding="12,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <iconPacks:PackIconLucide Kind="RefreshCw"
                                                      Width="14" Height="14"
                                                      Margin="0,0,8,0"
                                                      VerticalAlignment="Center" />
                            <TextBlock Text="Refresh" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <local:IssuesPanel x:Name="IssuesPanelHost" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
