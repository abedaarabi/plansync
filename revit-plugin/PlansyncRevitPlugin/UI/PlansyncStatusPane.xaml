<UserControl x:Class="PlansyncRevitPlugin.UI.PlansyncStatusPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PlansyncSurfaceAltBrush}"
             Foreground="{DynamicResource PlansyncTextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
             FontSize="12">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PlansyncRevitPlugin;component/UI/Themes/PlansyncTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- Header -->
            <Border Background="{DynamicResource PlansyncSurfaceBrush}" BorderBrush="{DynamicResource PlansyncBorderBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Margin="-14,-12,-14,10" Height="3">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{DynamicResource PlansyncHeaderBarStartColor}" Offset="0" />
                                <GradientStop Color="{DynamicResource PlansyncHeaderBarEndColor}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <DockPanel Grid.Row="1" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26"
                                    CornerRadius="8"
                                    Background="{DynamicResource PlansyncAccentTintBgBrush}"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <Image x:Name="LogoImage"
                                       Width="16" Height="16"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Border>
                            <TextBlock FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"><Run Text="Plan" Foreground="{DynamicResource PlansyncTextBrush}" /><Run Text="Sync" Foreground="{DynamicResource PlansyncAccentBrush}" /></TextBlock>
                        </StackPanel>
                        <Border x:Name="AuthBadge"
                                DockPanel.Dock="Right"
                                Background="{DynamicResource PlansyncSurfaceAltBrush}"
                                BorderBrush="{DynamicResource PlansyncBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="999"
                                Padding="8,3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource PlansyncFaintTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="AccountStateText"
                                           Text="Checking…"
                                           Foreground="{DynamicResource PlansyncPlaceholderTextBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Grid>
            </Border>

            <StackPanel Margin="12">
                <!-- Account -->
                <Border Background="{DynamicResource PlansyncSurfaceBrush}"
                        BorderBrush="{DynamicResource PlansyncBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="ACCOUNT"
                                   Foreground="{DynamicResource PlansyncFaintTextBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <TextBlock x:Name="UserText"
                                   Text="Not signed in"
                                   Foreground="{DynamicResource PlansyncTextBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />
                        <Button x:Name="AuthActionButton"
                                Content="Sign in"
                                Style="{StaticResource PlansyncSecondaryButton}"
                                HorizontalAlignment="Stretch"
                                Click="AuthAction_Click"
                                Padding="12,9" />
                    </StackPanel>
                </Border>

                <!-- Destination -->
                <Border Background="{DynamicResource PlansyncSurfaceBrush}"
                        BorderBrush="{DynamicResource PlansyncBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="DESTINATION"
                                       Foreground="{DynamicResource PlansyncFaintTextBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="DestinationReadyText"
                                       DockPanel.Dock="Right"
                                       HorizontalAlignment="Right"
                                       Text="Not set"
                                       Foreground="{DynamicResource PlansyncErrorAccentBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </DockPanel>

                        <TextBlock Text="Workspace" Foreground="{DynamicResource PlansyncFaintTextBrush}" FontSize="10" />
                        <TextBlock x:Name="WorkspaceText"
                                   Text="—"
                                   Foreground="{DynamicResource PlansyncTextBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,1,0,8"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="Project" Foreground="{DynamicResource PlansyncFaintTextBrush}" FontSize="10" />
                        <TextBlock x:Name="ProjectText"
                                   Text="—"
                                   Foreground="{DynamicResource PlansyncTextBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,1,0,8"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="Folder" Foreground="{DynamicResource PlansyncFaintTextBrush}" FontSize="10" />
                        <Border Background="{DynamicResource PlansyncAccentTintBgBrush}"
                                BorderBrush="{DynamicResource PlansyncAccentTintBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,6"
                                Margin="0,3,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{DynamicResource PlansyncAccentBrush}"
                                              Data="M10,4 H4 C2.9,4 2.01,4.9 2.01,6 V18 C2.01,19.1 2.9,20 4,20 H20 C21.1,20 22,19.1 22,18 V8 C22,6.9 21.1,6 20,6 H12 L10,4 Z" />
                                        <Path Fill="{DynamicResource PlansyncAccentIconBrush}"
                                              Data="M3,9.5 H21 V18 C21,19.1 20.1,20 19,20 H5 C3.9,20 3,19.1 3,18 Z" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="FolderText"
                                           Text="—"
                                           Foreground="{DynamicResource PlansyncAccentTintTextBrush}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Last publish -->
                <Border Background="{DynamicResource PlansyncSurfaceBrush}"
                        BorderBrush="{DynamicResource PlansyncBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="LAST PUBLISH"
                                   Foreground="{DynamicResource PlansyncFaintTextBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <TextBlock x:Name="LastPublishSummaryText"
                                   Text="No publish yet this session."
                                   Foreground="{DynamicResource PlansyncTextBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="LastPublishTimeText"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource PlansyncPlaceholderTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="LastPublishFilesText"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource PlansyncSecondaryTextBrush}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Activity / queue -->
                <Border Background="{DynamicResource PlansyncSurfaceBrush}"
                        BorderBrush="{DynamicResource PlansyncBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="ACTIVITY"
                                       Foreground="{DynamicResource PlansyncFaintTextBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                            <Border x:Name="QueueBadge"
                                    DockPanel.Dock="Right"
                                    Background="{DynamicResource PlansyncWarnBgBrush}"
                                    BorderBrush="{DynamicResource PlansyncWarnBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="999"
                                    Padding="8,2"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="QueueBadgeText"
                                           Text="0 queued"
                                           Foreground="{DynamicResource PlansyncWarnTextBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                            </Border>
                        </DockPanel>
                        <TextBlock x:Name="StatusText"
                                   Text="Ready to publish."
                                   Foreground="{DynamicResource PlansyncSecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="QueueFilesText"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource PlansyncPlaceholderTextBrush}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Button x:Name="OpenDestinationButton"
                        Content="Open in Plansync"
                        Style="{StaticResource PlansyncPrimaryButton}"
                        HorizontalAlignment="Stretch"
                        Click="OpenDestination_Click"
                        Margin="0,0,0,8"
                        Padding="12,10" />
                <Button x:Name="RetryQueueButton"
                        Content="Retry offline queue"
                        Style="{StaticResource PlansyncSecondaryButton}"
                        HorizontalAlignment="Stretch"
                        Click="RetryQueue_Click"
                        Margin="0,0,0,8"
                        Padding="12,10"
                        Visibility="Collapsed" />
                <Button Content="Refresh"
                        Style="{StaticResource PlansyncSecondaryButton}"
                        HorizontalAlignment="Stretch"
                        Click="Refresh_Click"
                        Padding="12,10" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
