<Window x:Class="PlansyncRevitPlugin.UI.ExportToPlansyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PlansyncRevitPlugin.UI"
        Title="Plansync — Export"
        Width="1100" Height="800"
        MinWidth="960" MinHeight="680"
        Background="{DynamicResource PlansyncBgBrush}"
        Foreground="{DynamicResource PlansyncTextBrush}"
        FontFamily="Segoe UI, sans-serif"
        FontSize="13"
        ResizeMode="CanResize"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PlansyncRevitPlugin;component/UI/Themes/PlansyncTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="18,14"
                BorderBrush="{DynamicResource PlansyncBorderBrush}"
                BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{DynamicResource PlansyncHeaderBarStartColor}" Offset="0" />
                    <GradientStop Color="{DynamicResource PlansyncHeaderBarEndColor}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="LogoImage"
                           Width="28"
                           Height="28"
                           Stretch="Uniform"
                           Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Export"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock Text="IFC model and PDF drawings"
                                   FontSize="11.5"
                                   Foreground="#94A3B8"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Right"
                        Background="#152033"
                        BorderBrush="#243044"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="16,0,0,0"
                        MaxWidth="420"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="DESTINATION"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#94A3B8"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal"
                                        DockPanel.Dock="Right"
                                        HorizontalAlignment="Right">
                                <ToggleButton Content="Cloud"
                                              Style="{StaticResource PlansyncSegmentToggle}"
                                              IsChecked="{Binding IsCloudDestination, Mode=TwoWay}"
                                              Padding="8,4"
                                              FontSize="11"
                                              Foreground="#CBD5E1" />
                                <ToggleButton Content="Computer"
                                              Style="{StaticResource PlansyncSegmentToggle}"
                                              IsChecked="{Binding IsCloudDestination, Mode=TwoWay, Converter={StaticResource InverseBool}}"
                                              Padding="8,4"
                                              FontSize="11"
                                              Foreground="#CBD5E1"
                                              Margin="4,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right"
                                    Content="Change"
                                    Style="{StaticResource PlansyncSecondaryButton}"
                                    Command="{Binding ChooseDestinationCommand}"
                                    Visibility="{Binding ShowChooseDestination, Converter={StaticResource BoolToVis}}"
                                    MinWidth="0"
                                    Padding="8,4"
                                    Margin="8,0,0,0" />
                            <TextBlock Text="{Binding DestinationLabel}"
                                       Foreground="#E2E8F0"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Toolbar: format + profile -->
        <Border Grid.Row="1"
                Background="{DynamicResource PlansyncSurfaceBrush}"
                BorderBrush="{DynamicResource PlansyncBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="WHAT TO EXPORT"
                               Style="{StaticResource PlansyncSectionLabel}"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource PlansyncHoverBgBrush}"
                            BorderBrush="{DynamicResource PlansyncBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Content="IFC"
                                          Style="{StaticResource PlansyncSegmentToggle}"
                                          IsChecked="{Binding IsFormatIfcOnly, Mode=TwoWay}"
                                          MinWidth="56" />
                            <ToggleButton Content="PDF"
                                          Style="{StaticResource PlansyncSegmentToggle}"
                                          IsChecked="{Binding IsFormatPdfOnly, Mode=TwoWay}"
                                          MinWidth="56" />
                            <ToggleButton Content="Both"
                                          Style="{StaticResource PlansyncSegmentToggle}"
                                          IsChecked="{Binding IsFormatBoth, Mode=TwoWay}"
                                          MinWidth="56" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <DockPanel>
                        <TextBlock Text="PROFILE"
                                   Style="{StaticResource PlansyncSectionLabel}"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Content="Save as…"
                                Style="{StaticResource PlansyncSecondaryButton}"
                                Command="{Binding SaveProfileCommand}"
                                MinWidth="0"
                                Padding="10,6"
                                Margin="8,0,0,0" />
                        <ComboBox ItemsSource="{Binding Profiles}"
                                  Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedItem="{Binding SelectedProfileName}"
                                  IsEditable="True"
                                  Height="32"
                                  VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding ProfileStatus}"
                               Style="{StaticResource PlansyncCaptionText}"
                               Foreground="{DynamicResource PlansyncAccentBrush}"
                               Margin="0,4,0,0"
                               Visibility="{Binding HasProfileStatus, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Segment tabs -->
        <Border Grid.Row="2"
                Background="{DynamicResource PlansyncBgBrush}"
                Padding="16,12,16,0">
            <Border Background="{DynamicResource PlansyncHoverBgBrush}"
                    BorderBrush="{DynamicResource PlansyncBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="3"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton Content="IFC"
                                  Style="{StaticResource PlansyncSegmentToggle}"
                                  IsChecked="{Binding IsIfcTab, Mode=TwoWay}"
                                  IsEnabled="{Binding IncludeIfc}"
                                  MinWidth="72" />
                    <ToggleButton Content="PDF"
                                  Style="{StaticResource PlansyncSegmentToggle}"
                                  IsChecked="{Binding IsPdfTab, Mode=TwoWay}"
                                  IsEnabled="{Binding IncludePdf}"
                                  MinWidth="72" />
                    <ToggleButton Content="QA"
                                  Style="{StaticResource PlansyncSegmentToggle}"
                                  IsChecked="{Binding IsQaTab, Mode=TwoWay}"
                                  MinWidth="72" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Tab content -->
        <Grid Grid.Row="3" Margin="16,12,16,0">
            <!-- IFC -->
            <Grid DataContext="{Binding Ifc}"
                  Visibility="{Binding DataContext.IsIfcTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource PlansyncCard}" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="IFC VERSION" Style="{StaticResource PlansyncSectionLabel}" />
                                <ComboBox ItemsSource="{Binding VersionOptions, Mode=OneTime}"
                                          SelectedItem="{Binding SelectedVersionOption}"
                                          DisplayMemberPath="Label"
                                          Height="32" />
                                <TextBlock Text="{Binding SelectedVersionOption.SubLabel}"
                                           Style="{StaticResource PlansyncCaptionText}"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PlansyncCard}" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="MODEL SCOPE" Style="{StaticResource PlansyncSectionLabel}" />
                                <RadioButton Content="Whole model"
                                             Style="{StaticResource PlansyncRadio}"
                                             IsChecked="{Binding WholeModel, Mode=TwoWay}"
                                             GroupName="IfcScope" />
                                <RadioButton Content="Filter by view"
                                             Style="{StaticResource PlansyncRadio}"
                                             IsChecked="{Binding FilterByView, Mode=TwoWay}"
                                             GroupName="IfcScope" />
                                <TextBlock Text="Filter view (3D first)"
                                           Style="{StaticResource PlansyncSectionLabel}"
                                           Margin="0,8,0,6" />
                                <ComboBox ItemsSource="{Binding Views}"
                                          SelectedItem="{Binding SelectedView}"
                                          IsEnabled="{Binding IsViewListEnabled}"
                                          DisplayMemberPath="Name"
                                          Height="32" />
                                <TextBlock Text="For full 3D elements + rooms: use Whole model, or Filter by a 3D view."
                                           Style="{StaticResource PlansyncCaptionText}"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PlansyncCard}" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="LEVELS" Style="{StaticResource PlansyncSectionLabel}" />
                                <CheckBox Content="Include all levels as building storeys"
                                          Style="{StaticResource PlansyncCheckBox}"
                                          IsChecked="{Binding IncludeAllLevelsAsBuildingStories}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PlansyncCard}" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="PLANSYNC 2D + ROOMS" Style="{StaticResource PlansyncSectionLabel}" />
                                <CheckBox Content="Include rooms (IfcSpace)"
                                          Style="{StaticResource PlansyncCheckBox}"
                                          IsChecked="{Binding ExportRoomsInView}" />
                                <CheckBox Content="Include 2D floor cut / plan elements"
                                          Style="{StaticResource PlansyncCheckBox}"
                                          IsChecked="{Binding Export2DElements}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PlansyncCard}" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="PROPERTY SETS" Style="{StaticResource PlansyncSectionLabel}" />
                                <CheckBox Content="IFC common property sets"
                                          Style="{StaticResource PlansyncCheckBox}"
                                          IsChecked="{Binding ExportIfcCommonPropertySets}" />
                                <CheckBox Content="Base quantities"
                                          Style="{StaticResource PlansyncCheckBox}"
                                          IsChecked="{Binding ExportBaseQuantities}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PlansyncCard}" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="PARAMETER MODE" Style="{StaticResource PlansyncSectionLabel}" />
                                <RadioButton Content="All Revit property sets"
                                             Style="{StaticResource PlansyncRadio}"
                                             IsChecked="{Binding AllRevitPropertySets, Mode=TwoWay}"
                                             GroupName="IfcParamMode" />
                                <RadioButton Content="Selected parameters only"
                                             Style="{StaticResource PlansyncRadio}"
                                             IsChecked="{Binding SelectedParametersOnly, Mode=TwoWay}"
                                             GroupName="IfcParamMode" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Column="2" Style="{StaticResource PlansyncCard}" Padding="12" Margin="0" IsEnabled="{Binding IsParameterListEnabled}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="PARAMETERS"
                                       Style="{StaticResource PlansyncSectionLabel}"
                                       VerticalAlignment="Center"
                                       Margin="0" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding SelectedCountText}"
                                       Foreground="{StaticResource PlansyncMutedBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBox Grid.Row="1"
                                 Style="{StaticResource PlansyncSearchBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8" />

                        <DockPanel Grid.Row="2" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <ToggleButton Content="Shared" Style="{StaticResource PlansyncChipToggle}" IsChecked="{Binding ShowShared}" />
                                <ToggleButton Content="Project" Style="{StaticResource PlansyncChipToggle}" IsChecked="{Binding ShowProject}" />
                                <ToggleButton Content="Built-in" Style="{StaticResource PlansyncChipToggle}" IsChecked="{Binding ShowBuiltIn}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <Button Content="Select visible"
                                        Style="{StaticResource PlansyncSecondaryButton}"
                                        Command="{Binding SelectAllVisibleCommand}"
                                        Margin="0,0,6,0"
                                        MinWidth="0"
                                        Padding="10,5" />
                                <Button Content="Clear"
                                        Style="{StaticResource PlansyncSecondaryButton}"
                                        Command="{Binding ClearVisibleCommand}"
                                        MinWidth="0"
                                        Padding="10,5" />
                            </StackPanel>
                        </DockPanel>

                        <ListView Grid.Row="3"
                                  BorderBrush="{StaticResource PlansyncBorderBrush}"
                                  BorderThickness="1"
                                  ItemsSource="{Binding ParametersView}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="36">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="220" />
                                    <GridViewColumn Header="Kind" DisplayMemberBinding="{Binding KindLabel}" Width="90" />
                                    <GridViewColumn Header="Group" DisplayMemberBinding="{Binding Group}" Width="140" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- PDF master–detail -->
            <Grid DataContext="{Binding Pdf}"
                  Visibility="{Binding DataContext.IsPdfTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.42*" MinWidth="320" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="0.58*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PlansyncCard}" Padding="12" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="DRAWINGS" Style="{StaticResource PlansyncSectionLabel}" Margin="0" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedCountText}" Foreground="{StaticResource PlansyncMutedBrush}" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBox Grid.Row="1"
                                 Style="{StaticResource PlansyncSearchBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8" />

                        <DockPanel Grid.Row="2" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <ToggleButton Content="Sheets" Style="{StaticResource PlansyncChipToggle}" IsChecked="{Binding ShowSheets}" />
                                <ToggleButton Content="Views" Style="{StaticResource PlansyncChipToggle}" IsChecked="{Binding ShowViews}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <Button Content="All sheets" Style="{StaticResource PlansyncSecondaryButton}" Command="{Binding SelectAllSheetsCommand}" MinWidth="0" Padding="8,5" Margin="0,0,6,0" />
                                <Button Content="Visible" Style="{StaticResource PlansyncSecondaryButton}" Command="{Binding SelectAllVisibleCommand}" MinWidth="0" Padding="8,5" Margin="0,0,6,0" />
                                <Button Content="Clear" Style="{StaticResource PlansyncSecondaryButton}" Command="{Binding ClearCommand}" MinWidth="0" Padding="8,5" />
                            </StackPanel>
                        </DockPanel>

                        <CheckBox Grid.Row="3"
                                  Content="Changed sheets only"
                                  Style="{StaticResource PlansyncCheckBox}"
                                  IsChecked="{Binding DataContext.ChangedSheetsOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Margin="0,0,0,8" />

                        <ListBox Grid.Row="4"
                                 x:Name="DrawingsList"
                                 BorderBrush="{StaticResource PlansyncBorderBrush}"
                                 BorderThickness="1"
                                 ItemsSource="{Binding DrawingsView}"
                                 SelectedItem="{Binding FocusedDrawing, Mode=TwoWay}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="DrawingsList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <CheckBox DockPanel.Dock="Left"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0" />
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource PlansyncTextBrush}">
                                                <Run Text="{Binding SheetNumber, Mode=OneWay}" />
                                                <Run Text=" " />
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding ViewTypeName}"
                                                       Style="{StaticResource PlansyncCaptionText}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <local:DrawingPreviewPanel x:Name="PreviewPanel" Grid.Row="0" />

                    <Border Grid.Row="1" Style="{StaticResource PlansyncCard}" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="OUTPUT OPTIONS" Style="{StaticResource PlansyncSectionLabel}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton Content="One combined PDF"
                                             Style="{StaticResource PlansyncRadio}"
                                             IsChecked="{Binding Combine, Mode=TwoWay}"
                                             GroupName="PdfCombineMode"
                                             Margin="0,0,16,0" />
                                <RadioButton Content="One file per drawing"
                                             Style="{StaticResource PlansyncRadio}"
                                             IsChecked="{Binding OneFilePerSheet, Mode=TwoWay}"
                                             GroupName="PdfCombineMode" />
                            </StackPanel>
                            <TextBlock Text="Naming template" Style="{StaticResource PlansyncCaptionText}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NamingTemplate, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PlansyncSearchBox}" />
                            <TextBlock Text="{}{SheetNumber}_{SheetName} · {ViewName} · {DocumentTitle} · {Date}"
                                       Style="{StaticResource PlansyncCaptionText}"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="{Binding SuggestedOutputName, StringFormat='Suggested: {0}'}"
                                       Foreground="{DynamicResource PlansyncAccentTintTextBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- QA -->
            <Border Style="{StaticResource PlansyncCard}"
                    Padding="16"
                    VerticalAlignment="Top"
                    Visibility="{Binding IsQaTab, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="PARAMETER QA" Style="{StaticResource PlansyncSectionLabel}" />
                    <TextBlock Style="{StaticResource PlansyncSubtitleText}"
                               Text="When IFC uses selected parameters, Plansync can sample the model and warn if those parameters look empty."
                               Margin="0,0,0,12" />
                    <CheckBox Content="Warn before upload if selected parameters look empty"
                              Style="{StaticResource PlansyncCheckBox}"
                              IsChecked="{Binding WarnOnParamQa}" />
                    <CheckBox Content="Block publish when parameter QA fails"
                              Style="{StaticResource PlansyncCheckBox}"
                              IsChecked="{Binding BlockOnParamQa}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="4"
                Background="{DynamicResource PlansyncSurfaceBrush}"
                BorderBrush="{DynamicResource PlansyncBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Cancel"
                            Style="{StaticResource PlansyncSecondaryButton}"
                            Click="Cancel_Click"
                            Margin="0,0,10,0"
                            IsCancel="True" />
                    <Button Content="{Binding ExportButtonLabel}"
                            Style="{StaticResource PlansyncPrimaryButton}"
                            Click="Export_Click"
                            IsDefault="True" />
                </StackPanel>
                <TextBlock Text="{Binding ExportSummary}"
                           Style="{StaticResource PlansyncCaptionText}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,16,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
