<UserControl x:Class="PlansyncRevitPlugin.UI.DrawingPreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PlansyncRevitPlugin;component/UI/Themes/PlansyncTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="{DynamicResource PlansyncSurfaceBrush}"
            BorderBrush="{DynamicResource PlansyncBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="160" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="PREVIEW"
                           Style="{StaticResource PlansyncSectionLabel}"
                           Margin="0"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="TypeBadge"
                           DockPanel.Dock="Right"
                           Style="{StaticResource PlansyncCaptionText}"
                           VerticalAlignment="Center" />
            </DockPanel>

            <Border Grid.Row="1"
                    Background="{DynamicResource PlansyncSurfaceAltBrush}"
                    BorderBrush="{DynamicResource PlansyncBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
                <Grid>
                    <TextBlock x:Name="EmptyText"
                               Text="Select a drawing to preview."
                               Foreground="{DynamicResource PlansyncPlaceholderTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="16"
                               TextAlignment="Center" />
                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"
                           Margin="6"
                           Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="LoadingText"
                               Text="Generating preview…"
                               Foreground="{DynamicResource PlansyncMutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <StackPanel x:Name="DetailsPanel" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock Text="Sheet / view" Style="{StaticResource PlansyncCaptionText}" />
                <TextBlock x:Name="NameText"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PlansyncTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,8" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Number" Style="{StaticResource PlansyncCaptionText}" />
                        <TextBlock x:Name="NumberText"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PlansyncTextBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Type" Style="{StaticResource PlansyncCaptionText}" />
                        <TextBlock x:Name="TypeText"
                                   Foreground="{DynamicResource PlansyncTextBrush}"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Will export as" Style="{StaticResource PlansyncCaptionText}" Margin="0,10,0,4" />
                <Border Background="{DynamicResource PlansyncAccentTintBgBrush}"
                        BorderBrush="{DynamicResource PlansyncAccentTintBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,6">
                    <TextBlock x:Name="ExportNameText"
                               Foreground="{DynamicResource PlansyncAccentTintTextBrush}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               FontSize="12" />
                </Border>
            </StackPanel>

            <Button x:Name="OpenInRevitButton"
                    Grid.Row="3"
                    Content="Open in Revit"
                    Style="{StaticResource PlansyncSecondaryButton}"
                    Margin="0,12,0,0"
                    Padding="12,7"
                    HorizontalAlignment="Stretch"
                    IsEnabled="False"
                    Click="OpenInRevit_Click" />
        </Grid>
    </Border>
</UserControl>
