<UserControl x:Class="PlansyncRevitPlugin.UI.IssuesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:conv="clr-namespace:PlansyncRevitPlugin.UI.Converters"
             xmlns:vm="clr-namespace:PlansyncRevitPlugin.UI.ViewModels"
             Background="{DynamicResource PlansyncSurfaceAltBrush}"
             Foreground="{DynamicResource PlansyncTextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
             FontSize="12">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PlansyncRevitPlugin;component/UI/Themes/PlansyncTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />

            <Style x:Key="IssuesFilterChip" TargetType="ToggleButton" BasedOn="{StaticResource PlansyncChipToggle}">
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="FontSize" Value="11" />
            </Style>

            <Style x:Key="IssuesIconButton" TargetType="Button" BasedOn="{StaticResource PlansyncSecondaryButton}">
                <Setter Property="Padding" Value="8,7" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            </Style>

            <DataTemplate DataType="{x:Type vm:IssueRowViewModel}">
                <Border x:Name="Row"
                        Background="Transparent"
                        CornerRadius="10"
                        Padding="10,9"
                        Margin="0,0,0,4"
                        Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="8" Height="8"
                                CornerRadius="99"
                                VerticalAlignment="Top"
                                Margin="0,5,8,0"
                                Background="{DynamicResource PlansyncAccentBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="RESOLVED">
                                            <Setter Property="Background" Value="{DynamicResource PlansyncSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="CLOSED">
                                            <Setter Property="Background" Value="{DynamicResource PlansyncFaintTextBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Priority}" Value="HIGH">
                                            <Setter Property="Background" Value="{DynamicResource PlansyncErrorAccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource PlansyncTextBrush}" />
                            <TextBlock Text="{Binding MetaLine}"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource PlansyncPlaceholderTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <iconPacks:PackIconLucide Grid.Column="2"
                                                  Kind="Box"
                                                  Width="14" Height="14"
                                                  VerticalAlignment="Top"
                                                  Margin="8,4,0,0"
                                                  Foreground="{DynamicResource PlansyncAccentBrush}"
                                                  Visibility="{Binding HasBim, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource PlansyncSelectedBgBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource PlansyncSurfaceBrush}"
                BorderBrush="{DynamicResource PlansyncBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconLucide Kind="CircleAlert"
                                                  Width="16" Height="16"
                                                  Foreground="{DynamicResource PlansyncAccentBrush}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0" />
                        <TextBlock Text="Issues"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <Border Margin="8,0,0,0"
                                Background="{DynamicResource PlansyncAccentTintBgBrush}"
                                BorderBrush="{DynamicResource PlansyncAccentTintBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="999"
                                Padding="8,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding OpenCountLabel}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PlansyncAccentTintTextBrush}" />
                        </Border>
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource IssuesIconButton}"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Refresh from Plansync">
                        <iconPacks:PackIconLucide Kind="RefreshCw" Width="15" Height="15"
                                                  Foreground="{DynamicResource PlansyncTextBrush}" />
                    </Button>
                </DockPanel>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <iconPacks:PackIconLucide Kind="Search"
                                              Width="14" Height="14"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              Panel.ZIndex="1"
                                              Foreground="{DynamicResource PlansyncFaintTextBrush}" />
                    <TextBox Grid.Column="0" Grid.ColumnSpan="2"
                             Style="{StaticResource PlansyncSearchBox}"
                             Padding="32,8,10,8"
                             FontSize="12"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search title, description, assignee" />
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <ToggleButton Content="Open"
                                  Style="{StaticResource IssuesFilterChip}"
                                  IsChecked="{Binding IsFilterOpen, Mode=OneWay}"
                                  Command="{Binding FilterOpenCommand}" />
                    <ToggleButton Content="BIM"
                                  Style="{StaticResource IssuesFilterChip}"
                                  IsChecked="{Binding IsFilterBim, Mode=OneWay}"
                                  Command="{Binding FilterBimCommand}" />
                    <ToggleButton Content="All"
                                  Style="{StaticResource IssuesFilterChip}"
                                  IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                                  Command="{Binding FilterAllCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- List + detail -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.1*" MinHeight="120" />
                <RowDefinition Height="6" />
                <RowDefinition Height="1.4*" MinHeight="160" />
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0"
                     Margin="8,8,8,4"
                     ItemsSource="{Binding FilteredIssues}"
                     SelectedItem="{Binding Selected}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <GridSplitter Grid.Row="1"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource PlansyncBorderBrush}"
                          ShowsPreview="True" />

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="12,8,12,4">
                <StackPanel>
                    <TextBlock Text="{Binding DetailTitle}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />

                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <!-- BIM pair chips -->
                        <StackPanel Margin="0,0,0,10"
                                    Visibility="{Binding Selected.HasBim, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="MODEL ELEMENTS"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PlansyncFaintTextBrush}"
                                       Margin="0,0,0,6" />
                            <Border Background="{DynamicResource PlansyncClashItem1BgBrush}"
                                    BorderBrush="{DynamicResource PlansyncClashItem1BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,6"
                                    Margin="0,0,0,6">
                                <DockPanel>
                                    <Ellipse Width="10" Height="10"
                                             Fill="{DynamicResource PlansyncClashItem1Brush}"
                                             Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Selected.Item1Name}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource PlansyncClashItem1TextBrush}" />
                                </DockPanel>
                            </Border>
                            <Border Background="{DynamicResource PlansyncClashItem2BgBrush}"
                                    BorderBrush="{DynamicResource PlansyncClashItem2BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,6"
                                    Visibility="{Binding Selected.HasItem2, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <Ellipse Width="10" Height="10"
                                             Fill="{DynamicResource PlansyncClashItem2Brush}"
                                             Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Selected.Item2Name}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource PlansyncClashItem2TextBrush}" />
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="STATUS"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PlansyncFaintTextBrush}"
                                   Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding EditStatus}"
                                  Margin="0,0,0,8"
                                  Padding="8,6" />

                        <TextBlock Text="PRIORITY"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PlansyncFaintTextBrush}"
                                   Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding PriorityOptions}"
                                  SelectedItem="{Binding EditPriority}"
                                  Margin="0,0,0,8"
                                  Padding="8,6" />

                        <TextBlock Text="DESCRIPTION"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PlansyncFaintTextBrush}"
                                   Margin="0,0,0,4" />
                        <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PlansyncSearchBox}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="72"
                                 VerticalContentAlignment="Top"
                                 Padding="10,8"
                                 Margin="0,0,0,10" />

                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <Button Margin="0,0,4,0"
                                    Style="{StaticResource PlansyncPrimaryButton}"
                                    Command="{Binding OpenIn3dCommand}"
                                    Padding="10,9">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="BoxSelect"
                                                              Width="14" Height="14"
                                                              Foreground="White"
                                                              Margin="0,0,6,0"
                                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Open in 3D" VerticalAlignment="Center" Foreground="White" />
                                </StackPanel>
                            </Button>
                            <Button Margin="4,0,0,0"
                                    Style="{StaticResource PlansyncSecondaryButton}"
                                    Command="{Binding ResetViewCommand}"
                                    Padding="10,9">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="RotateCcw"
                                                              Width="14" Height="14"
                                                              Margin="0,0,6,0"
                                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Reset view" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <UniformGrid Columns="2" Margin="0,0,0,4">
                            <Button Margin="0,0,4,0"
                                    Style="{StaticResource PlansyncSecondaryButton}"
                                    Command="{Binding SaveCommand}"
                                    Padding="10,9">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="Save"
                                                              Width="14" Height="14"
                                                              Margin="0,0,6,0"
                                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Save" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Margin="4,0,0,0"
                                    Style="{StaticResource PlansyncSecondaryButton}"
                                    Command="{Binding MarkResolvedCommand}"
                                    Padding="10,9">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="CircleCheck"
                                                              Width="14" Height="14"
                                                              Foreground="{DynamicResource PlansyncSuccessTextBrush}"
                                                              Margin="0,0,6,0"
                                                              VerticalAlignment="Center" />
                                    <TextBlock Text="Resolve" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <Button Style="{StaticResource PlansyncSecondaryButton}"
                                Command="{Binding OpenInWebCommand}"
                                HorizontalAlignment="Stretch"
                                Padding="10,9"
                                Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <iconPacks:PackIconLucide Kind="ExternalLink"
                                                          Width="14" Height="14"
                                                          Margin="0,0,6,0"
                                                          VerticalAlignment="Center" />
                                <TextBlock Text="Open in Plansync web" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Visibility="{Binding HasSelection, Converter={StaticResource InvertBoolToVis}}"
                            Background="{DynamicResource PlansyncSurfaceBrush}"
                            BorderBrush="{DynamicResource PlansyncBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,4,0,0">
                        <StackPanel>
                            <iconPacks:PackIconLucide Kind="Inbox"
                                                      Width="22" Height="22"
                                                      Foreground="{DynamicResource PlansyncFaintTextBrush}"
                                                      HorizontalAlignment="Center"
                                                      Margin="0,0,0,8" />
                            <TextBlock Text="Select an issue to review, edit, and open in 3D."
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource PlansyncPlaceholderTextBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer status -->
        <Border Grid.Row="2"
                Background="{DynamicResource PlansyncSurfaceBrush}"
                BorderBrush="{DynamicResource PlansyncBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <StackPanel>
                <DockPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <iconPacks:PackIconLucide Kind="LoaderCircle"
                                              Width="14" Height="14"
                                              Margin="0,0,6,0"
                                              Foreground="{DynamicResource PlansyncAccentBrush}" />
                    <TextBlock Text="Working…"
                               Foreground="{DynamicResource PlansyncPlaceholderTextBrush}"
                               FontSize="11" />
                </DockPanel>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="11"
                           Foreground="{DynamicResource PlansyncSecondaryTextBrush}"
                           TextWrapping="Wrap" />
                <Border Margin="0,6,0,0"
                        Background="{DynamicResource PlansyncErrorBgBrush}"
                        BorderBrush="{DynamicResource PlansyncErrorBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,6"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource PlansyncErrorTextBrush}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
