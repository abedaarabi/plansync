<UserControl x:Class="PlansyncRevitPlugin.UI.IssuesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:conv="clr-namespace:PlansyncRevitPlugin.UI.Converters"
             xmlns:vm="clr-namespace:PlansyncRevitPlugin.UI.ViewModels"
             Background="{DynamicResource PlansyncSurfaceAltBrush}"
             Foreground="{DynamicResource PlansyncTextBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
             FontSize="12.5"
             PreviewKeyDown="Panel_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PlansyncRevitPlugin;component/UI/Themes/PlansyncTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />

            <DataTemplate DataType="{x:Type vm:IssueRowViewModel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot"
                             Width="8" Height="8"
                             VerticalAlignment="Top"
                             Margin="0,4,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource PlansyncFaintTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="OPEN">
                                        <Setter Property="Fill" Value="{DynamicResource PlansyncErrorAccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="IN_PROGRESS">
                                        <Setter Property="Fill" Value="{DynamicResource PlansyncWarnTextBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="RESOLVED">
                                        <Setter Property="Fill" Value="{DynamicResource PlansyncSuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource PlansyncRowTitle}" />
                        <DockPanel Margin="0,4,0,0" LastChildFill="True">
                            <Border DockPanel.Dock="Left"
                                    CornerRadius="4"
                                    Padding="6,1"
                                    Margin="0,0,8,0"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource PlansyncHoverBgBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PlansyncBorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Priority}" Value="HIGH">
                                                <Setter Property="Background" Value="{DynamicResource PlansyncErrorBgBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource PlansyncErrorBorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Priority}" Value="MEDIUM">
                                                <Setter Property="Background" Value="{DynamicResource PlansyncAccentTintBgBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource PlansyncAccentTintBorderBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding PriorityLabel}" FontSize="12" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource PlansyncSecondaryTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Priority}" Value="HIGH">
                                                    <Setter Property="Foreground" Value="{DynamicResource PlansyncErrorTextBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Priority}" Value="MEDIUM">
                                                    <Setter Property="Foreground" Value="{DynamicResource PlansyncAccentTintTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="{Binding AssigneeLabel}"
                                       Style="{StaticResource PlansyncMetaText}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Grid Width="20" Height="20"
                              Margin="8,0,0,0"
                              ToolTip="{Binding AssigneeLabel}">
                            <Ellipse Fill="{DynamicResource PlansyncAccentTintBgBrush}"
                                     Stroke="{DynamicResource PlansyncAccentTintBorderBrush}"
                                     StrokeThickness="1" />
                            <TextBlock Text="{Binding AssigneeInitials}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PlansyncAccentTintTextBrush}"
                                       Visibility="{Binding HasAssigneeAvatar, Converter={StaticResource InvertBoolToVis}}" />
                            <Ellipse Visibility="{Binding HasAssigneeAvatar, Converter={StaticResource BoolToVis}}">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AssigneeAvatar}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <iconPacks:PackIconLucide Kind="Box"
                                                  Width="13" Height="13"
                                                  Margin="6,4,0,0"
                                                  Foreground="{DynamicResource PlansyncAccentBrush}"
                                                  Visibility="{Binding HasBim, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource PlansyncSurfaceBrush}"
                BorderBrush="{DynamicResource PlansyncBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,8"
                Visibility="{Binding IsListOpen, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PlansyncIconButton}"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Refresh from Plansync">
                        <iconPacks:PackIconLucide Kind="RefreshCw" Width="14" Height="14"
                                                  Foreground="{DynamicResource PlansyncTextBrush}" />
                    </Button>
                    <Grid>
                        <iconPacks:PackIconLucide Kind="Search"
                                                  Width="13" Height="13"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Panel.ZIndex="1"
                                                  Foreground="{DynamicResource PlansyncFaintTextBrush}" />
                        <TextBox Style="{StaticResource PlansyncSearchBox}"
                                 Padding="28,5,8,5"
                                 FontSize="12.5"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search title, description, assignee" />
                    </Grid>
                </DockPanel>

                <WrapPanel>
                    <ToggleButton Content="This model"
                                  Style="{StaticResource PlansyncChipToggle}"
                                  IsChecked="{Binding IsThisModelScope, Mode=OneWay}"
                                  Command="{Binding ShowThisModelCommand}" />
                    <ToggleButton Content="All project"
                                  Style="{StaticResource PlansyncChipToggle}"
                                  IsChecked="{Binding IsAllProjectScope, Mode=OneWay}"
                                  Command="{Binding ShowAllProjectCommand}" />
                    <ToggleButton Content="Open"
                                  Style="{StaticResource PlansyncChipToggle}"
                                  IsChecked="{Binding IsFilterOpen, Mode=OneWay}"
                                  Command="{Binding FilterOpenCommand}" />
                    <ToggleButton Content="BIM"
                                  Style="{StaticResource PlansyncChipToggle}"
                                  IsChecked="{Binding IsFilterBim, Mode=OneWay}"
                                  Command="{Binding FilterBimCommand}" />
                    <ToggleButton Content="All"
                                  Style="{StaticResource PlansyncChipToggle}"
                                  IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                                  Command="{Binding FilterAllCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="0"
                Background="{DynamicResource PlansyncSurfaceBrush}"
                BorderBrush="{DynamicResource PlansyncBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6"
                Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource PlansyncCompactButton}"
                        Command="{Binding BackToListCommand}"
                        ToolTip="Back to issues"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="ArrowLeft" Width="13" Height="13"
                                                  Foreground="{DynamicResource PlansyncTextBrush}"
                                                  VerticalAlignment="Center" />
                        <TextBlock Text="Back" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding DetailTitle}"
                           Style="{StaticResource PlansyncRowTitle}"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <ListBox x:Name="IssuesList"
                     Margin="8"
                     ItemsSource="{Binding FilteredIssues}"
                     SelectedItem="{Binding Selected}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="List_PreviewKeyDown"
                     Visibility="{Binding IsListOpen, Converter={StaticResource BoolToVis}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource PlansyncPaneListItem}" />
                </ListBox.ItemContainerStyle>
            </ListBox>

            <StackPanel VerticalAlignment="Center"
                        Margin="24,16"
                        Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding EmptyTitle}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{DynamicResource PlansyncTextBrush}" />
                <TextBlock Text="{Binding EmptyBody}"
                           Margin="0,6,0,10"
                           FontSize="12"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{DynamicResource PlansyncMutedBrush}" />
                <Button Style="{StaticResource PlansyncCompactButton}"
                        Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Center"
                        Content="Refresh" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="12,8,12,8"
                          Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="0,0,0,10">
                        <Grid Width="24" Height="24" DockPanel.Dock="Left" Margin="0,0,8,0">
                            <Ellipse Fill="{DynamicResource PlansyncAccentTintBgBrush}"
                                     Stroke="{DynamicResource PlansyncAccentTintBorderBrush}"
                                     StrokeThickness="1" />
                            <TextBlock Text="{Binding Selected.AssigneeInitials}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PlansyncAccentTintTextBrush}"
                                       Visibility="{Binding Selected.HasAssigneeAvatar, Converter={StaticResource InvertBoolToVis}}" />
                            <Ellipse Visibility="{Binding Selected.HasAssigneeAvatar, Converter={StaticResource BoolToVis}}">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding Selected.AssigneeAvatar}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Assignee" Style="{StaticResource PlansyncFieldLabel}" Margin="0" />
                            <TextBlock Text="{Binding Selected.AssigneeLabel}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource PlansyncTextBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Margin="0,0,0,10"
                                Visibility="{Binding HasSelectedPhoto, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Photo" Style="{StaticResource PlansyncFieldLabel}" />
                        <Border Width="120" Height="84"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource PlansyncSurfaceAltBrush}"
                                BorderBrush="{DynamicResource PlansyncBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="2">
                            <Image Source="{Binding SelectedPhotoUrl}" Stretch="UniformToFill" />
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10"
                                Visibility="{Binding Selected.HasBim, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Model elements" Style="{StaticResource PlansyncFieldLabel}" />
                        <Border Background="{DynamicResource PlansyncClashItem1BgBrush}"
                                BorderBrush="{DynamicResource PlansyncClashItem1BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,6"
                                Margin="0,0,0,6">
                            <DockPanel>
                                <Ellipse Width="8" Height="8"
                                         Fill="{DynamicResource PlansyncClashItem1Brush}"
                                         Margin="0,3,8,0"
                                         VerticalAlignment="Top" />
                                <TextBlock Text="{Binding Selected.Item1Name}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource PlansyncTextBrush}" />
                            </DockPanel>
                        </Border>
                        <Border Background="{DynamicResource PlansyncClashItem2BgBrush}"
                                BorderBrush="{DynamicResource PlansyncClashItem2BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,6"
                                Visibility="{Binding Selected.HasItem2, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Ellipse Width="8" Height="8"
                                         Fill="{DynamicResource PlansyncClashItem2Brush}"
                                         Margin="0,3,8,0"
                                         VerticalAlignment="Top" />
                                <TextBlock Text="{Binding Selected.Item2Name}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource PlansyncTextBrush}" />
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Status" Style="{StaticResource PlansyncFieldLabel}" />
                            <ComboBox ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding EditStatus}"
                                      Style="{StaticResource PlansyncComboBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Priority" Style="{StaticResource PlansyncFieldLabel}" />
                            <ComboBox ItemsSource="{Binding PriorityOptions}"
                                      SelectedItem="{Binding EditPriority}"
                                      Style="{StaticResource PlansyncComboBox}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Description" Style="{StaticResource PlansyncFieldLabel}" />
                    <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource PlansyncTextArea}"
                             MinHeight="56"
                             MaxHeight="110"
                             Margin="0,0,0,10" />

                    <TextBlock Text="{Binding CommentsHeader}"
                               Style="{StaticResource PlansyncFieldLabel}" />
                    <Border Background="{DynamicResource PlansyncSurfaceBrush}"
                            BorderBrush="{DynamicResource PlansyncBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,0,0,8">
                        <Grid MinHeight="48" MaxHeight="160">
                            <TextBlock Text="Loading…"
                                       Margin="10,8"
                                       Style="{StaticResource PlansyncMetaText}"
                                       Visibility="{Binding IsCommentsLoading, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="No comments yet."
                                       Margin="10,8"
                                       Style="{StaticResource PlansyncMetaText}"
                                       Visibility="{Binding CommentsEmptyVisible, Converter={StaticResource BoolToVis}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Padding="8,8,4,8"
                                          Visibility="{Binding HasComments, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Comments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:IssueCommentRowViewModel}">
                                            <DockPanel Margin="0,0,0,8">
                                                <Grid Width="20" Height="20"
                                                      DockPanel.Dock="Left"
                                                      Margin="0,1,8,0"
                                                      VerticalAlignment="Top">
                                                    <Ellipse Fill="{DynamicResource PlansyncAccentTintBgBrush}" />
                                                    <TextBlock Text="{Binding AuthorInitials}"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding HasAuthorAvatar, Converter={StaticResource InvertBoolToVis}}" />
                                                    <Ellipse Visibility="{Binding HasAuthorAvatar, Converter={StaticResource BoolToVis}}">
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding AuthorAvatar}" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding CreatedAtLabel}"
                                                                   DockPanel.Dock="Right"
                                                                   Style="{StaticResource PlansyncMetaText}"
                                                                   Margin="8,0,0,0" />
                                                        <TextBlock Text="{Binding AuthorName}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Body}"
                                                               Margin="0,2,0,0"
                                                               FontSize="12.5"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource PlansyncSecondaryTextBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource PlansyncIconButton}"
                                Command="{Binding PostCommentCommand}"
                                ToolTip="Add comment"
                                Margin="6,0,0,0">
                            <iconPacks:PackIconLucide Kind="Send" Width="13" Height="13"
                                                      Foreground="{DynamicResource PlansyncAccentBrush}" />
                        </Button>
                        <TextBox Text="{Binding NewComment, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PlansyncSearchBox}"
                                 ToolTip="Write a comment" />
                    </DockPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PlansyncLinkButton}"
                                Command="{Binding MarkResolvedCommand}"
                                Content="Mark resolved"
                                Margin="0,0,16,0" />
                        <Button Style="{StaticResource PlansyncLinkButton}"
                                Command="{Binding OpenInWebCommand}"
                                Content="Open in web" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource PlansyncSurfaceBrush}"
                BorderBrush="{DynamicResource PlansyncBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,8">
            <StackPanel>
                <WrapPanel Margin="0,0,0,6" Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource PlansyncCompactPrimaryButton}"
                            Command="{Binding OpenIn3dCommand}"
                            Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Box" Width="13" Height="13" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Open 3D" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PlansyncCompactButton}"
                            Command="{Binding OpenIn2dCommand}"
                            Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Map" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Show 2D" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PlansyncCompactButton}"
                            Command="{Binding OpenSectionBoxCommand}"
                            Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="Scan" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Section" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PlansyncCompactButton}"
                            Command="{Binding ResetViewCommand}"
                            Margin="0,0,6,6"
                            Content="Reset" />
                    <Button Style="{StaticResource PlansyncCompactButton}"
                            Command="{Binding SaveCommand}"
                            Margin="0,0,6,6"
                            Content="Save" />
                </WrapPanel>
                <TextBlock Text="{Binding FooterText}"
                           TextWrapping="NoWrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlansyncMetaText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource PlansyncErrorTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource PlansyncAccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
