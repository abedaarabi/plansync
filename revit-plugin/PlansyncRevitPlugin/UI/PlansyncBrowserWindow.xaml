<Window x:Class="PlansyncRevitPlugin.UI.PlansyncBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PlansyncRevitPlugin.UI.ViewModels"
        Title="PlanSync — Choose destination"
        Width="960" Height="680"
        ResizeMode="NoResize"
        Background="{DynamicResource PlansyncBgBrush}"
        Foreground="{DynamicResource PlansyncTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PlansyncRevitPlugin;component/UI/Themes/PlansyncTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <Style x:Key="ExplorerListBox" TargetType="ListBox">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                CornerRadius="10"
                                                Padding="10,9">
                                            <Grid>
                                                <Border x:Name="Accent"
                                                        Width="3"
                                                        HorizontalAlignment="Left"
                                                        CornerRadius="2"
                                                        Background="Transparent"
                                                        Margin="-4,2,0,2" />
                                                <ContentPresenter Margin="6,0,0,0" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PlansyncSurfaceAltBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PlansyncAccentTintBgBrush}" />
                                                <Setter TargetName="Accent" Property="Background" Value="{DynamicResource PlansyncAccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ExplorerTreeView" TargetType="TreeView">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="6" />
            </Style>

            <Style TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="True" />
                <Setter Property="Padding" Value="8,7" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Foreground" Value="{DynamicResource PlansyncTextBrush}" />
            </Style>

            <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{DynamicResource PlansyncAccentBrush}"
                                  Data="M10,4 H4 C2.9,4 2.01,4.9 2.01,6 V18 C2.01,19.1 2.9,20 4,20 H20 C21.1,20 22,19.1 22,18 V8 C22,6.9 21.1,6 20,6 H12 L10,4 Z" />
                            <Path Fill="{DynamicResource PlansyncAccentIconBrush}"
                                  Data="M3,9.5 H21 V18 C21,19.1 20.1,20 19,20 H5 C3.9,20 3,19.1 3,18 Z" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="{Binding Name}"
                               Style="{StaticResource PlansyncEmphasisText}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{DynamicResource PlansyncPageGradientAColor}" Offset="0" />
                <GradientStop Color="{DynamicResource PlansyncPageGradientBColor}" Offset="0.55" />
                <GradientStop Color="{DynamicResource PlansyncPageGradientCColor}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{DynamicResource PlansyncSurfaceBrush}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource PlansyncHeaderBarStartColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource PlansyncHeaderBarEndColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource PlansyncBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="22,16">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36"
                                    CornerRadius="10"
                                    Background="{DynamicResource PlansyncAccentTintBgBrush}"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                <Image x:Name="LogoImage"
                                       Width="22" Height="22"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="17" FontWeight="SemiBold"><Run Text="Plan" Foreground="{DynamicResource PlansyncTextBrush}" /><Run Text="Sync" Foreground="{DynamicResource PlansyncAccentBrush}" /></TextBlock>
                                <TextBlock Text="Choose where exports will upload"
                                           Style="{StaticResource PlansyncCaptionText}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Border Background="{DynamicResource PlansyncSurfaceAltBrush}"
                                    BorderBrush="{DynamicResource PlansyncBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="999"
                                    Padding="12,7"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource PlansyncSuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding UserEmail}"
                                               Foreground="{DynamicResource PlansyncSecondaryTextBrush}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Button Content="Sign out"
                                    Style="{StaticResource PlansyncSecondaryButton}"
                                    MinWidth="0"
                                    Padding="12,8"
                                    Click="SignOut_Click" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: workspace + projects -->
            <Border Grid.Column="0"
                    Background="{DynamicResource PlansyncSurfaceBrush}"
                    BorderBrush="{DynamicResource PlansyncBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="WORKSPACE"
                               Style="{StaticResource PlansyncSectionLabel}" />
                    <ComboBox Grid.Row="1"
                              ItemsSource="{Binding Workspaces}"
                              SelectedItem="{Binding SelectedWorkspace}"
                              DisplayMemberPath="DisplayName"
                              Height="38"
                              Margin="0,0,0,18"
                              Padding="10,6"
                              BorderBrush="{DynamicResource PlansyncBorderBrush}"
                              Background="{DynamicResource PlansyncInputBgBrush}"
                              Foreground="{DynamicResource PlansyncInputTextBrush}" />

                    <TextBlock Grid.Row="2"
                               Text="PROJECTS"
                               Style="{StaticResource PlansyncSectionLabel}" />
                    <Border Grid.Row="3"
                            Background="{DynamicResource PlansyncSurfaceAltBrush}"
                            BorderBrush="{DynamicResource PlansyncBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <ListBox Style="{StaticResource ExplorerListBox}"
                                 ItemsSource="{Binding Projects}"
                                 SelectedItem="{Binding SelectedProject}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30"
                                                CornerRadius="8"
                                                Background="{DynamicResource PlansyncAccentTintStrongBrush}"
                                                Margin="0,0,10,0">
                                            <Viewbox Width="16" Height="16"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Fill="{DynamicResource PlansyncAccentBrush}"
                                                          Data="M10,4 H4 C2.9,4 2.01,4.9 2.01,6 V18 C2.01,19.1 2.9,20 4,20 H20 C21.1,20 22,19.1 22,18 V8 C22,6.9 21.1,6 20,6 H12 L10,4 Z" />
                                                    <Path Fill="{DynamicResource PlansyncAccentIconBrush}"
                                                          Data="M3,9.5 H21 V18 C21,19.1 20.1,20 19,20 H5 C3.9,20 3,19.1 3,18 Z" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PlansyncTextBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: folders -->
            <Border Grid.Column="2"
                    Background="{DynamicResource PlansyncSurfaceBrush}"
                    BorderBrush="{DynamicResource PlansyncBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right"
                                Content="+ New folder"
                                Style="{StaticResource PlansyncSecondaryButton}"
                                IsEnabled="{Binding CanCreateFolder}"
                                Click="NewFolder_Click"
                                MinWidth="0"
                                Padding="12,7"
                                Margin="12,0,0,0" />
                        <TextBlock DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"
                                   Text="{Binding StatusText}"
                                   Style="{StaticResource PlansyncCaptionText}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="FOLDERS"
                                   Style="{StaticResource PlansyncSectionLabel}"
                                   Margin="0"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <Border Grid.Row="1"
                            Background="{DynamicResource PlansyncAccentTintBgBrush}"
                            BorderBrush="{DynamicResource PlansyncAccentTintBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,10"
                            Margin="0,0,0,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Destination"
                                       Foreground="{DynamicResource PlansyncAccentBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DestinationSummary}"
                                       Foreground="{DynamicResource PlansyncAccentTintTextBrush}"
                                       FontSize="12.5"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{DynamicResource PlansyncSurfaceAltBrush}"
                            BorderBrush="{DynamicResource PlansyncBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <TreeView x:Name="FolderTree"
                                  Style="{StaticResource ExplorerTreeView}"
                                  ItemsSource="{Binding FolderRoots}"
                                  SelectedItemChanged="FolderTree_SelectedItemChanged" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource PlansyncSurfaceBrush}"
                BorderBrush="{DynamicResource PlansyncBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="22,16">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="Selected folder"
                               Style="{StaticResource PlansyncSectionLabel}"
                               Margin="0" />
                    <TextBlock Text="{Binding DestinationSummary}"
                               Foreground="{DynamicResource PlansyncSecondaryTextBrush}"
                               FontSize="12.5"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Cancel"
                            Style="{StaticResource PlansyncSecondaryButton}"
                            Click="Cancel_Click"
                            Margin="0,0,10,0"
                            IsCancel="True" />
                    <Button Content="Use this folder"
                            Style="{StaticResource PlansyncSecondaryButton}"
                            IsEnabled="{Binding CanExport}"
                            Click="UseFolder_Click"
                            Margin="0,0,10,0" />
                    <Button Content="Export to Plansync"
                            Style="{StaticResource PlansyncPrimaryButton}"
                            IsEnabled="{Binding CanExport}"
                            Click="Export_Click"
                            Padding="20,11" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
